# ─────────────────────────────────────────────────────────────
# dsh-tool-modpack .gitignore
# 说明：本仓库**刻意保留 lib/**（构建产物随源码一起发布，这样
#      `dsh plugin --profile x add "github:<owner>/dsh-tool-modpack"`
#       无需本地构建即可直接使用）。除 lib/ 之外的产物目录一律忽略。
# ─────────────────────────────────────────────────────────────

# 依赖
node_modules/
jspm_packages/
bower_components/

# 构建产物 / 覆盖率 / 缓存（注意：lib/ 不在其中，必须入库）
dist
build/Release
lib-cov
coverage/
*.lcov
.nyc_output/
.cache/
*.tsbuildinfo

# 日志
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 运行时数据
pids
*.pid
*.seed
*.pid.lock

# 环境变量与凭据 —— 绝不入库（真实凭据只放本机 .secrets.env）
.env
.env.*
!.env.example
.secrets.env
*.pem
*.key

# 包管理器 / 工具缓存
.npm
.eslintcache
.node_repl_history
*.tgz
.yarn-integrity

# 编辑器与操作系统噪声
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
.DS_Store
Thumbs.db
*.swp
*.swo

# 本项目的本地目录与临时文件
tmp/
*.bak-*
*.tmp-*

# 整合包导出产物：若在仓库目录内误跑 modpack_export，产物落在这里
/out/
